BootStrap: docker
From: ubuntu:26.04

%files

    # the binary is large, so copy it rather than download
    metashape-pro_2_3_1_amd64.tar.gz /opt

    License.lic /var/tmp/agisoft/licensing/licenses/

%post

    export DEBIAN_FRONTEND=noninteractive
    export TZ=Etc/UTC

    apt-get update && apt-get upgrade -y

    apt-get install -y locales
    locale-gen en_US.UTF-8
    update-locale LANG=en_US.UTF-8
    export LANG=en_US.UTF-8

    apt-get install -y python3 python3-pip

    apt-get install -y \
        libglib2.0-0 \
        libdbus-1-3 \
        libgssapi-krb5-2 \
        ca-certificates \
        libgl1 \
        libx11-6 libx11-xcb1 libxext6 libxrender1 libxi6 \
        libxrandr2 libxss1 libxtst6 libxcomposite1 libxcursor1 libxfixes3 \
        libxkbcommon-x11-0 \
        libxcb1 libxcb-cursor0 libxcb-keysyms1 libxcb-image0 libxcb-icccm4 libxcb-render-util0 \
        libxcb-xinerama0 libxcb-xinput0 \
        libxcb-shm0 libxcb-shape0 \
	less \
	libglu1-mesa \
	libcurl4t64 \
	libfontconfig1 \
	libsm6

    cd /opt
    tar xzf metashape-pro_2_3_1_amd64.tar.gz
    rm metashape-pro_2_3_1_amd64.tar.gz

    apt-get clean && rm -rf /var/lib/apt/lists/*

%runscript
    exec /opt/metashape-pro/metashape.sh "$@"
